{
  "name": "ha-snapmaker-u1-print-status-card",
  "version": "0.1.1",
  "description": "A graphical print-status + control card for the Snapmaker U1 (Paxx Extended Firmware / Moonraker) in Home Assistant",
  "main": "index.js",
  "scripts": {
    "start": "rollup -c --watch --bundleConfigAsCjs",
    "build": "cross-env IGNORE_TS_ERRORS=true rollup -c --bundleConfigAsCjs",
    "build:strict": "cross-env IGNORE_TS_ERRORS=false rollup -c --bundleConfigAsCjs",
    "format": "prettier --write .",
    "verify": "ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/verify-resolver.ts",
    "smoke": "node scripts/smoke-render.mjs"
  },
  "author": "Mitchell",
  "repository": {
    "type": "git",
    "url": "https://github.com/StealthFireMS/ha-snapmaker-u1-print-status-card"
  },
  "license": "MIT",
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "rollup": "^4.18.0",
    "rollup-plugin-serve": "^1.1.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3"
  }
}
